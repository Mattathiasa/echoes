# ── API ──────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://echoes:echoes@localhost:5432/echoes
JWT_SECRET=changeme_at_least_32_chars_long_please
PORT=3001

# ── LLM provider: groq (hosted, free tier) or ollama (local, free forever) ──
LLM_PROVIDER=groq
GROQ_API_KEY=           # free key at https://console.groq.com
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ── Storage ───────────────────────────────────────────────────────────────────
UPLOADS_DIR=./uploads   # local path; swap for a Supabase Storage URL in prod

# ── Frontend (apps/web/.env) ──────────────────────────────────────────────────
# VITE_API_URL=http://localhost:3001
